# Copia este archivo a .env y completa tus valores. .env nunca se sube al repo.

# Puerto del servidor local
PORT=3000

# Proveedor de LLM a usar por /api/generate-script: "nvidia" | "freellmapi" | "custom"
LLM_PROVIDER=nvidia

# API key del proveedor elegido
LLM_API_KEY=

# Opcional: pisa el endpoint base OpenAI-compatible (sin /chat/completions al final).
#   NVIDIA NIM ya trae por defecto: https://integrate.api.nvidia.com/v1
#   FreeLLMAPI: no hay una URL publica unica, completa aca la que te dio tu cuenta/proyecto
LLM_BASE_URL=

# Opcional: pisa el modelo a usar (default NVIDIA NIM: meta/llama-3.3-70b-instruct;
# otras opciones del catalogo NIM: mistralai/mistral-large-2-instruct)
LLM_MODEL=

# Opcional: timeout por intento (ms) para el LLM de texto (guion/prompts). Default 18000
# (18s) — bastante mas corto que el resto de llamadas externas, para no dejar al usuario
# esperando casi 2 minutos si el proveedor esta colgado. Se reintenta automaticamente.
LLM_TIMEOUT_MS=18000

# --- Fallback LLM (opcional) ---
# Si el proveedor primario no responde dentro de LLM_TIMEOUT_MS, se prueba este segundo
# proveedor antes de reintentar el primario una vez mas. Pensado para un proveedor
# "ultra rapido" como Groq (LPU, latencias tipicamente <2s) o un endpoint local/self-hosted
# compatible con el esquema OpenAI de /chat/completions.
# Con LLM_FALLBACK_API_KEY vacio, el fallback queda deshabilitado.

# "groq" (usa los defaults de abajo) | "custom" (completa LLM_FALLBACK_BASE_URL/MODEL)
LLM_FALLBACK_PROVIDER=groq

# Tu API key de https://console.groq.com (gratis) u otro proveedor compatible.
# GROQ_API_KEY funciona igual como alias si preferis ese nombre.
LLM_FALLBACK_API_KEY=

# Opcional: pisa el endpoint. Groq ya trae por defecto: https://api.groq.com/openai/v1
LLM_FALLBACK_BASE_URL=

# Opcional: pisa el modelo. Groq ya trae por defecto: llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=

# --- TTS (locución) usado por /api/generate-audio ---

# Proveedor de TTS: "voicebox" | "fishaudio" | "nvidia" | "local" | "custom"
# voicebox (https://voicebox.sh) es una app local de voz (FastAPI en 127.0.0.1:17493,
# con perfiles de voz propios) — no necesita API key, solo tenerla abierta.
TTS_PROVIDER=voicebox

# API key del proveedor de TTS. No hace falta si TTS_PROVIDER=voicebox o local.
#   Fish Audio: tu key de https://fish.audio
#   NVIDIA NIM (TTS_PROVIDER=nvidia): si la dejas vacia, reusa automaticamente LLM_API_KEY
#   (misma cuenta NVIDIA NIM) — normalmente no hace falta setearla aca por separado.
TTS_API_KEY=

# Opcional: pisa el endpoint base.
#   Voicebox ya trae por defecto: http://127.0.0.1:17493
#   Fish Audio ya trae por defecto: https://api.fish.audio/v1
#   NVIDIA NIM ya trae por defecto: https://integrate.api.nvidia.com/v1
#   Para un servidor de TTS local/propio, completa aca la URL completa de tu endpoint
#   (ej. http://localhost:8080/tts)
TTS_BASE_URL=

# Opcional: pisa el modelo a usar (NVIDIA NIM ya trae por defecto:
#   resembleai/chatterbox-multilingual-tts). No aplica a Voicebox (usa "perfiles" en vez
#   de modelos — ver TTS_VOICE_ID).
TTS_MODEL=

# Opcional: id (o nombre) de perfil/voz a usar por defecto si el front no manda uno propio.
#   Voicebox: id de perfil (ver GET /api/voice-profiles, o la app misma)
TTS_VOICE_ID=

# Opcional: formato de audio a pedir al proveedor (mp3 por defecto; Voicebox ignora esto,
# siempre sirve el archivo ya generado tal cual)
TTS_FORMAT=mp3

# --- Medios de escena (video B-roll / imagen IA) usado por /api/generate-scene-media ---
#
# Por cada escena del paso 7, el servidor intenta primero un B-roll de VIDEO real con
# Wan2GP y, si no esta configurado o falla para esa escena puntual, cae a una imagen IA
# (Pollinations.ai por defecto, gratis y sin API key). server.js reusa tal cual
# ultron/scripts/lib/generateBrolls.js y generateImage.js -- no hay nada que configurar
# aca: TODAS las variables de este paso viven en ultron/.env (WAN2GP_ROOT, WAN2GP_PYTHON,
# WAN2GP_TIMEOUT_S, IMAGE_PROVIDER, IMAGE_TIMEOUT_MS -- ver ultron/.env.example), porque
# ese mismo .env ya las documenta y las usa tambien el pipeline CLI standalone de ultron.
# server.js carga ese archivo ademas del propio (ver loadDotEnv() en server.js), asi que
# alcanza con completarlas en un solo lugar.
#
# Sin WAN2GP_ROOT configurado en ultron/.env, este paso usa directo Pollinations -- no
# hace falta nada para que funcione. Wan2GP esta documentado como NO VERIFICADO
# end-to-end (ver ultron/README.md) -- probalo primero standalone antes de confiar en el
# resultado desde la app.

# --- NexLev (paso 3, botón "🔥 Idea Tendencia") usado por /api/nexlev-trend-idea ---
#
# Toma un video de YouTube de referencia + el canal elegido, le pide a NexLev videos
# similares/en tendencia a partir de ese video, y usa el LLM configurado arriba (LLM_PROVIDER)
# para sintetizar un título ganador, un slogan y el ángulo de investigación del guion.
#
# Consigue tu API key gratis en https://dashboard.nexlev.io/n8n-youtube (creando cuenta antes).
# Es la API REST clásica (header x-api-key) -- NO el servidor MCP de NexLev, que está pensado
# para conectar Claude/ChatGPT como asistente vía OAuth desde el navegador, no para un backend.
NEXLEV_API_KEY=

# Opcional: timeout (ms) para la llamada a NexLev. Default 45000 (45s).
NEXLEV_TIMEOUT_MS=45000

# --- yt-dlp (paso 3, botón "🔎 Idea Tendencia (YouTube, gratis)") usado por
#     /api/trend-idea/youtube ---
#
# Alternativa 100% gratis a NexLev para el mismo botón: busca directo en YouTube (sin API key,
# sin login) con yt-dlp, usando el nicho del canal como query. Requiere yt-dlp instalado:
#   python -m pip install -U yt-dlp
# Sin nada configurado acá abajo, ya funciona (usa "python" del PATH).
YTDLP_PYTHON=python
YTDLP_SEARCH_COUNT=8
YTDLP_TIMEOUT_MS=30000

# --- Telegram (paso 10, botón "Publicar en Telegram") usado por /api/publish/telegram ---
#
# 1. Hablale a @BotFather en Telegram, mandale /newbot y seguí los pasos -- te da un token
#    como "123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx".
# 2. TELEGRAM_CHAT_ID, según a dónde quieras que lleguen los archivos:
#    - Directo a vos por chat privado con el bot: mandale cualquier mensaje al bot primero
#      (los bots no pueden escribirle a alguien que nunca les escribió) y pedile a Claude que
#      te averigüe tu id numérico con el método getUpdates de la API de Telegram.
#    - A un canal o grupo: agregá el bot como administrador ahí, y usá el @usuario del canal
#      (si es público) o su id numérico (si es privado).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: timeout (ms) para la subida a Telegram. Default 120000 (2 min) -- más largo que
# el resto de llamadas externas porque sube el video entero, no solo texto/JSON.
TELEGRAM_TIMEOUT_MS=120000

# --- Renderizado de video (paso 9) usado por /api/render-video ---

# Opcional: ruta completa al ejecutable de ffmpeg, si no esta en el PATH del sistema.
# Con ffmpeg instalado normalmente (choco/winget/apt/brew) no hace falta tocar esto.
FFMPEG_PATH=
