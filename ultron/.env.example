# Copiá este archivo a .env (mismo directorio) si querés pisar algún default
# de la generación de imágenes IA por escena (paso 4 de generate-video.js).
# Sin este archivo, ese paso ya funciona igual (usa Pollinations.ai, ver
# abajo) -- no hace falta nada para que ande.

# Proveedor de imágenes: "pollinations" (default, gratis, sin API key) |
# "nvidia" | "skyreels" | "none"/"off"/"disabled" (vuelve al fondo negro
# sólido de antes, cero llamadas de red).
IMAGE_PROVIDER=pollinations

# --- wan2gp (B-rolls de VIDEO real, opcional -- ver scripts/lib/generateBrolls.js) ---
# Sin WAN2GP_ROOT, este paso ni se intenta y cada escena usa directo el
# IMAGE_PROVIDER de abajo (comportamiento normal). Con WAN2GP_ROOT
# configurado, cada escena intenta PRIMERO un clip de video real con Wan2GP
# -- si falla o no está disponible, esa escena puntual cae sola a imagen IA,
# no rompe el pipeline.
#
# NO VERIFICADO end-to-end (2026-08-21): no hubo una instalación real de
# Wan2GP disponible para probar. Wan2GP no tiene una API REST tradicional --
# su unica via documentada es un SDK de Python in-process (shared/api.py),
# asi que este puente corre un subproceso Python (scripts/wan2gp_bridge.py)
# que llama a ese SDK directo. Necesita Python + las dependencias de Wan2GP
# instaladas y resolubles desde WAN2GP_PYTHON. Si tu instalacion real espera
# otro "model_type" u otros parametros del SDK, ajustar la construcción de
# SETTINGS en wan2gp_bridge.py.
WAN2GP_ROOT=

# Interprete de Python a usar (default: "python" del PATH)
WAN2GP_PYTHON=python

# Segundos maximos de espera por clip antes de rendirse y caer a imagen IA
WAN2GP_TIMEOUT_S=300

# --- nvidia (NVIDIA NIM, modelo black-forest-labs/flux.1-schnell) ---
# Reusa LLM_API_KEY del .env del proyecto padre si no completás esta acá
# (misma cuenta NVIDIA NIM). Completala solo si tenés una key distinta.
# NOTA (probado 2026-08-20): con la key del proyecto, este endpoint no
# respondió (0 bytes en 90s) -- probablemente falta el entitlement de NVCF
# para modelos de imagen en esa cuenta (es un producto separado de los NIM
# de chat/texto). Confirmar en https://build.nvidia.com si tu cuenta lo tiene
# habilitado antes de asumir que es un bug del código.
NVIDIA_IMAGE_API_KEY=

# --- skyreels (servidor local propio) ---
# Sin contrato público documentado -- este mismo archivo (generateImageSkyReels, más abajo
# en scripts/lib/generateImage.js) asume el esquema más común, mismo enfoque best-effort
# que el resto de los proveedores locales/propios de este proyecto. Ajustar ahí si tu
# servidor real espera otro formato de request/response.
SKYREELS_URL=http://localhost:8000

# Timeout por imagen (ms). Con 5-8 escenas por video, un timeout largo acá
# puede sumar minutos si el proveedor está colgado -- se corta y esa escena
# queda sin imagen en vez de trabar el pipeline entero.
IMAGE_TIMEOUT_MS=45000

# --- Gemini (image-generation-skill, generación de imagen standalone) ---
# Repo clonado en <raíz del proyecto>/image-generation-skill (ver
# ultron/scripts/lib/generateGeminiImage.js + ultron/scripts/gemini_image_bridge.py).
# Sin GEMINI_API_KEY, esta función devuelve null sin romper nada -- es
# independiente del IMAGE_PROVIDER de arriba, no se usa en el pipeline de
# escenas a menos que se cablee a propósito.
GEMINI_API_KEY=

# Opcional: modelo a usar (default: gemini-3.1-flash-image-preview -- el más
# barato/rápido del catálogo de imagen de Gemini a la fecha).
GEMINI_IMAGE_MODEL=

# Opcional: ruta al repo clonado, si no está en la raíz del proyecto.
GEMINI_SKILL_ROOT=

# Opcional: intérprete de Python a usar. Por default se autodetecta el de
# image-generation-skill/.venv (creado con "uv venv" + "uv pip install -e .").
GEMINI_SKILL_PYTHON=

# --- Alineación de timestamps real (opcional, paso 3) ---
# Ruta a un modelo .bin de whisper.cpp para usar el filtro nativo `whisper`
# de ffmpeg en vez del split proporcional. Ver README.md.
ULTRON_WHISPER_MODEL=

# --- BGM y SFX (paso 5, mezcla con FFmpeg -- ver scripts/lib/mixAudio.js) ---
# No hay variables que configurar acá: el paso elige solo una pista al azar
# de public/assets/audio/bgm/ (si hay alguna) y agrega un SFX al azar de
# public/assets/audio/sfx/ en cada corte de escena (si hay alguno). Carpeta
# vacía o inexistente = ese elemento queda afuera, sin romper nada. Para
# desactivar del todo, vaciá ambas carpetas.
#
# El repo trae un pad ambient sintetizado (bgm/ambient-pad.mp3) y dos SFX
# sintetizados (sfx/pop.mp3, sfx/whoosh.mp3) como placeholders -- pisalos con
# tus propios archivos libres de derechos.
